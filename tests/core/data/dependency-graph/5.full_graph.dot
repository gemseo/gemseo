digraph {
	node [fillcolor=white style=filled]
	d0 [label=A]
	d1 [label=B]
	d2 [label=C]
	d3 [label=D]
	d4 [label=E]
	d0 -> d1 [label=a labeltooltip="Global name, Name in discipline 'A', Name in discipline 'B'

a, a, a"]
	d0 -> d2 [label=c labeltooltip="Global name, Name in discipline 'A', Name in discipline 'C'

c, c, c"]
	d1 -> d0 [label=b labeltooltip="Global name, Name in discipline 'B', Name in discipline 'A'

b, b, b"]
	d2 -> d3 [label=d labeltooltip="Global name, Name in discipline 'C', Name in discipline 'D'

d, d, d"]
	d3 -> d2 [label=e labeltooltip="Global name, Name in discipline 'D', Name in discipline 'C'

e, e, e"]
	d3 -> d4 [label=f labeltooltip="Global name, Name in discipline 'D', Name in discipline 'E'

f, f, f"]
}
