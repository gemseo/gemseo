digraph {
	node [fillcolor=white style=filled]
	d0 [label=D0]
	d1 [label=D1]
	d2 [label=D2]
	d1 -> d0 [label=y10 labeltooltip="Global name, Name in discipline 'D1', Name in discipline 'D0'

y10, y10, y10"]
	d1 -> d2 [label=y10 labeltooltip="Global name, Name in discipline 'D1', Name in discipline 'D2'

y10, y10, y10"]
	d2 -> d0 [label=y2 labeltooltip="Global name, Name in discipline 'D2', Name in discipline 'D0'

y2, y2, y2"]
	d2 -> d1 [label=y2 labeltooltip="Global name, Name in discipline 'D2', Name in discipline 'D1'

y2, y2, y2"]
	d1 -> d1 [label=y11 labeltooltip="Global name, Output name in discipline 'D1', Input name in discipline 'D1'

y11, y11, y11"]
	d0 -> h0 [label=y0 labeltooltip="Global name, Name in discipline 'D0'

y0, y0"]
	h0 [style=invis]
}
