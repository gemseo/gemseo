digraph {
	node [fillcolor=white style=filled]
	d0 [label=A]
	d1 [label=B]
	d2 [label=C]
	d3 [label=D]
	d0 -> d1 [label=a labeltooltip="Global name, Name in discipline 'A', Name in discipline 'B'

a, a, a"]
	d0 -> d2 [label=a labeltooltip="Global name, Name in discipline 'A', Name in discipline 'C'

a, a, a"]
	d1 -> d3 [label=b labeltooltip="Global name, Name in discipline 'B', Name in discipline 'D'

b, b, b"]
	d2 -> d3 [label=c labeltooltip="Global name, Name in discipline 'C', Name in discipline 'D'

c, c, c"]
	d3 -> h3 [label=d labeltooltip="Global name, Name in discipline 'D'

d, d"]
	h3 [style=invis]
}
