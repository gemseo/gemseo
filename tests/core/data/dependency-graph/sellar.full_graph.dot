digraph {
	node [fillcolor=white style=filled]
	d0 [label=Sellar1]
	d1 [label=Sellar2]
	d2 [label=SellarSystem]
	d0 -> d1 [label=y_1 labeltooltip="Global name, Name in discipline 'Sellar1', Name in discipline 'Sellar2'

y_1, y_1, y_1"]
	d0 -> d2 [label=y_1 labeltooltip="Global name, Name in discipline 'Sellar1', Name in discipline 'SellarSystem'

y_1, y_1, y_1"]
	d1 -> d0 [label=y_2 labeltooltip="Global name, Name in discipline 'Sellar2', Name in discipline 'Sellar1'

y_2, y_2, y_2"]
	d1 -> d2 [label=y_2 labeltooltip="Global name, Name in discipline 'Sellar2', Name in discipline 'SellarSystem'

y_2, y_2, y_2"]
	d2 -> h2 [label="c_1, c_2, obj" labeltooltip="Global name, Name in discipline 'SellarSystem'

c_1, c_1
c_2, c_2
obj, obj"]
	h2 [style=invis]
}
