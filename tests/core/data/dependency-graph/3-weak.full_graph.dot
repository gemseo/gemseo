digraph {
	node [fillcolor=white style=filled]
	d0 [label=A]
	d1 [label=B]
	d2 [label=C]
	d0 -> d1 [label=a labeltooltip="Global name, Name in discipline 'A', Name in discipline 'B'

a, a, a"]
	d0 -> d2 [label=a labeltooltip="Global name, Name in discipline 'A', Name in discipline 'C'

a, a, a"]
	d1 -> h1 [label=b labeltooltip="Global name, Name in discipline 'B'

b, b"]
	h1 [style=invis]
	d2 -> h2 [label=c labeltooltip="Global name, Name in discipline 'C'

c, c"]
	h2 [style=invis]
}
